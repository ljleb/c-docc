{
  "name": "docc",
  "displayName": "docc",
  "publisher": "ljleb",
  "license": "MIT",
  "version": "0.0.0",
  "description": "Review C and C++ documentation from Source Control and navigate from code to its referring docs.",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "package": "node prepare-package.js ../../build/vscode && cd ../../build/vscode && vsce package --no-dependencies --out ..",
    "vscode:prepublish": "node -e \"console.error('Run npm run package to package the release from VERSION.'); process.exit(1)\""
  },
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ljleb/c-docc.git",
    "directory": "editors/vscode"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "c-docc.refresh",
        "title": "Check Documentation",
        "category": "c-docc",
        "icon": "$(refresh)"
      },
      {
        "command": "c-docc.approve",
        "title": "Approve Documentation File",
        "category": "c-docc",
        "icon": "$(check)"
      },
      {
        "command": "c-docc.invalidate",
        "title": "Invalidate Documentation",
        "category": "c-docc"
      },
      {
        "command": "c-docc.install",
        "title": "Install CLI",
        "category": "c-docc"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "c-docc.invalidate",
          "when": "resourceScheme == file && (explorerResourceIsFolder || resourceExtname == .md || resourceExtname == .markdown)"
        }
      ],
      "scm/title": [
        {
          "command": "c-docc.refresh",
          "when": "scmProvider == c-docc",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "c-docc.approve",
          "when": "scmProvider == c-docc && scmResourceGroup == review",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "c-docc",
      "properties": {
        "c-docc.executable": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to c-docc relative to this workspace folder, or a command on PATH. When empty, look in the build directory, the extension’s storage, and then on PATH."
        },
        "c-docc.sourceDir": {
          "type": "string",
          "default": ".",
          "scope": "resource",
          "description": "Source directory relative to this workspace folder."
        },
        "c-docc.buildDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Directory containing compile_commands.json, relative to this workspace folder. When empty, look in build and then the source directory."
        },
        "c-docc.docsDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Markdown directory relative to this workspace folder. When empty, use docs inside the source directory if it exists, otherwise use the source directory."
        }
      }
    }
  },
  "files": [
    "extension.js",
    "installer.js",
    "windows-installer.js",
    "LICENSE"
  ]
}
