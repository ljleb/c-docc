{
  "name": "dagdocdiff",
  "displayName": "Dagdocdiff",
  "publisher": "ljleb",
  "license": "MIT",
  "version": "0.1.1",
  "description": "Review C and C++ documentation from Source Control and navigate from code to its referring docs.",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
  },
  "extensionKind": [
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ljleb/dagdocdiff.git",
    "directory": "editors/vscode"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "dagdocdiff.refresh",
        "title": "Check Documentation",
        "category": "Dagdocdiff",
        "icon": "$(refresh)"
      },
      {
        "command": "dagdocdiff.approve",
        "title": "Approve Documentation…",
        "category": "Dagdocdiff",
        "icon": "$(check)"
      },
      {
        "command": "dagdocdiff.install",
        "title": "Install CLI",
        "category": "Dagdocdiff"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "dagdocdiff.refresh",
          "when": "scmProvider == dagdocdiff",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "dagdocdiff.approve",
          "when": "scmProvider == dagdocdiff && scmResourceGroup == review",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Dagdocdiff",
      "properties": {
        "dagdocdiff.executable": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to Dagdocdiff relative to this workspace folder, or a command on PATH. When empty, look in the build directory, the extension’s storage, and then on PATH."
        },
        "dagdocdiff.sourceDir": {
          "type": "string",
          "default": ".",
          "scope": "resource",
          "description": "Source directory relative to this workspace folder."
        },
        "dagdocdiff.buildDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Directory containing compile_commands.json, relative to this workspace folder. When empty, look in build and then the source directory."
        },
        "dagdocdiff.docsDir": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Markdown directory relative to this workspace folder. When empty, use docs inside the source directory if it exists, otherwise use the source directory."
        }
      }
    }
  },
  "dagdocdiffFlake": "github:ljleb/dagdocdiff/1.12.0",
  "files": [
    "extension.js",
    "installer.js",
    "windows-installer.js",
    "LICENSE"
  ]
}
