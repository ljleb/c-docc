function(run_tool output)
    execute_process(
        COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
    )
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "${ARGN} failed with ${status}\n${stderr}\n${stdout}")
    endif()
    set(${output} "${stdout}" PARENT_SCOPE)
endfunction()

function(prepare_example name)
    set(root "${WORK_DIR}/${name}")
    set(example "${CMAKE_CURRENT_LIST_DIR}/../examples/dependency-diff/${name}")
    file(MAKE_DIRECTORY "${root}")
    configure_file("${example}/shared.hpp" "${root}/shared.hpp" COPYONLY)
    set(database "[]")
    set(index 0)
    foreach(file IN ITEMS a.cpp b.cpp caller.cpp legacy.c)
        configure_file("${example}/${file}" "${root}/${file}" COPYONLY)
        if(file STREQUAL "legacy.c")
            set(standard "-std=c17")
        else()
            set(standard "-std=c++20")
        endif()
        string(JSON database SET "${database}" ${index}
            "{\"directory\":\"${root}\",\"file\":\"${root}/${file}\",\"arguments\":[\"${CLANG}\",\"${standard}\",\"-c\",\"${root}/${file}\"]}")
        math(EXPR index "${index} + 1")
    endforeach()
    file(WRITE "${root}/compile_commands.json" "${database}\n")
endfunction()

function(find_entry out json list id)
    string(JSON count LENGTH "${json}" "${list}")
    if(count EQUAL 0)
        message(FATAL_ERROR "No entries for ${id} in ${list}")
    endif()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON item GET "${json}" "${list}" ${i})
        string(JSON found GET "${item}" id)
        if(found STREQUAL id)
            set(${out} "${item}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Missing ${id} in ${list}\n${json}")
endfunction()

prepare_example(base)
prepare_example(head)
prepare_example(comment-only)
set(base "${WORK_DIR}/base")
set(head "${WORK_DIR}/head")
set(comment "${WORK_DIR}/comment-only")

run_tool(version --version)
string(STRIP "${version}" version)
if(NOT version STREQUAL "dagdocdiff ${VERSION}")
    message(FATAL_ERROR "Unexpected version output: ${version}")
endif()

run_tool(scan scan "${base}" "${base}")
string(JSON tool_version GET "${scan}" tool_version)
if(NOT tool_version STREQUAL VERSION)
    message(FATAL_ERROR "Unexpected scan version: ${tool_version}")
endif()
foreach(id IN ITEMS "a.cpp::app::helper()" "b.cpp::app::helper()" "legacy.c::helper"
                    "legacy.c::struct State" "app::Reader::read() const &"
                    "inspect(int)" "inspect(double)" "c_value")
    find_entry(symbol "${scan}" symbols "${id}")
endforeach()
find_entry(symbol "${scan}" symbols "b.cpp::app::helper()")
string(JSON file GET "${symbol}" definition file)
if(NOT file STREQUAL "shared.hpp")
    message(FATAL_ERROR "Header helper has wrong definition file: ${file}")
endif()
find_entry(derived "${scan}" symbols "app::Derived")
string(JSON base_type GET "${derived}" dependencies 0 target)
if(NOT base_type STREQUAL "app::Base")
    message(FATAL_ERROR "Missing inheritance edge: ${derived}")
endif()
string(JSON findings LENGTH "${scan}" findings)
if(NOT findings EQUAL 0)
    message(FATAL_ERROR "Unexpected findings: ${scan}")
endif()

run_tool(diff diff "${base}" "${base}" "${head}" "${head}")
string(JSON count LENGTH "${diff}" changes)
if(NOT count EQUAL 3)
    message(FATAL_ERROR "Unexpected changes: ${diff}")
endif()
find_entry(a "${diff}" changes "app::a(int)")
find_entry(b "${diff}" changes "app::b(int)")
find_entry(caller "${diff}" changes "inspect(int)")
string(JSON a_kind GET "${a}" kind)
string(JSON b_kind GET "${b}" kind)
string(JSON caller_kind GET "${caller}" kind)
string(JSON cause GET "${caller}" dependency_path 1)
if(NOT a_kind STREQUAL "direct" OR NOT b_kind STREQUAL "cycle" OR
   NOT caller_kind STREQUAL "dependency" OR NOT cause STREQUAL "app::a(int)")
    message(FATAL_ERROR "Bad change classification or path: ${diff}")
endif()

run_tool(diff diff "${base}" "${base}" "${comment}" "${comment}")
string(JSON count LENGTH "${diff}" changes)
if(NOT count EQUAL 0)
    message(FATAL_ERROR "Comment-only edit changed hashes: ${diff}")
endif()

set(variants "${WORK_DIR}/variants")
file(MAKE_DIRECTORY "${variants}")
set(variant_source "${variants}/variant.c")
file(WRITE "${variant_source}" "int variant(void) { return ANSWER; }\n")
set(first "{\"directory\":\"${variants}\",\"file\":\"${variant_source}\",\"arguments\":[\"${CLANG}\",\"-DANSWER=1\",\"-c\",\"${variant_source}\"]}")
set(second "{\"directory\":\"${variants}\",\"file\":\"${variant_source}\",\"arguments\":[\"${CLANG}\",\"-DANSWER=1\",\"-DUNUSED=1\",\"-c\",\"${variant_source}\"]}")

file(WRITE "${variants}/compile_commands.json" "[${first}]\n")
run_tool(single_variant scan "${variants}" "${variants}")
file(WRITE "${variants}/compile_commands.json" "[${first},${second}]\n")
run_tool(equivalent_variants scan "${variants}" "${variants}")
if(NOT equivalent_variants STREQUAL single_variant)
    message(FATAL_ERROR "Equivalent compile commands changed the snapshot:\n${equivalent_variants}")
endif()

string(REPLACE "-DANSWER=1" "-DANSWER=2" conflict "${second}")
file(WRITE "${variants}/compile_commands.json" "[${first},${conflict}]\n")
execute_process(COMMAND "${PROGRAM}" scan "${variants}" "${variants}"
    RESULT_VARIABLE status ERROR_VARIABLE stderr)
if(NOT status EQUAL 1 OR NOT stderr MATCHES "conflicting definitions of variant")
    message(FATAL_ERROR "Expected conflicting compile commands to fail, got ${status}:\n${stderr}")
endif()

set(templates "${WORK_DIR}/templates")
file(MAKE_DIRECTORY "${templates}")
set(template_source "${templates}/dependent.cpp")
file(WRITE "${template_source}" [=[
template<class T> struct Holder {
    static T value;
    Holder(decltype(value)&&) {}
};
int regular() { return 0; }
]=])
file(WRITE "${templates}/compile_commands.json"
    "[{\"directory\":\"${templates}\",\"file\":\"${template_source}\",\"arguments\":[\"${CLANG}\",\"-std=c++20\",\"-c\",\"${template_source}\"]}]\n")
run_tool(dependent_template scan "${templates}" "${templates}")
find_entry(regular "${dependent_template}" symbols "regular()")
string(JSON template_symbol_count LENGTH "${dependent_template}" symbols)
if(NOT template_symbol_count EQUAL 1 OR NOT dependent_template MATCHES "unsupported function definition")
    message(FATAL_ERROR "Expected the dependent constructor to be reported as unsupported:\n${dependent_template}")
endif()
